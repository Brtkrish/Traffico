<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5" maxSpeed="13.9"/>

    <route id="N_to_S" edges="north_in center_out_s"/>
    <route id="N_to_E" edges="north_in center_out_e"/>
    <route id="N_to_W" edges="north_in center_out_w"/>

    <route id="S_to_N" edges="south_in center_out_n"/>
    <route id="S_to_E" edges="south_in center_out_e"/>
    <route id="S_to_W" edges="south_in center_out_w"/>

    <route id="E_to_W" edges="east_in center_out_w"/>
    <route id="E_to_N" edges="east_in center_out_n"/>
    <route id="E_to_S" edges="east_in center_out_s"/>

    <route id="W_to_E" edges="west_in center_out_e"/>
    <route id="W_to_N" edges="west_in center_out_n"/>
    <route id="W_to_S" edges="west_in center_out_s"/>

    <!-- Heavier traffic from North/South, lighter from East/West -->
    <!-- This asymmetry is what should trigger your adaptive logic to give NS more green time -->
    <flow id="flow_N" type="car" route="N_to_S" begin="0" end="600" probability="0.15"/>
    <flow id="flow_N2" type="car" route="N_to_E" begin="0" end="600" probability="0.08"/>
    <flow id="flow_S" type="car" route="S_to_N" begin="0" end="600" probability="0.15"/>
    <flow id="flow_S2" type="car" route="S_to_W" begin="0" end="600" probability="0.08"/>

    <flow id="flow_E" type="car" route="E_to_W" begin="0" end="600" probability="0.04"/>
    <flow id="flow_W" type="car" route="W_to_E" begin="0" end="600" probability="0.04"/>
</routes>
