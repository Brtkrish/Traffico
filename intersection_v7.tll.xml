<?xml version="1.0" encoding="UTF-8"?>
<additional>
    <!-- Protected-left program loaded after the original network program.
         Link order is the 16 controlled links of junction 'center'. -->
    <tlLogic id="center" type="static" programID="v7" offset="0">
        <!-- 0: North/South straight + right -->
        <phase duration="20" state="GGrrrrrrGGrrrrrr"/>
        <!-- 1: yellow for NS straight + right -->
        <phase duration="3"  state="yyrrrrrryyrrrrrr"/>

        <!-- 2: North/South protected left -->
        <phase duration="10" state="rrGrrrrrrrGrrrrr"/>
        <!-- 3: yellow for NS left -->
        <phase duration="3"  state="rryrrrrrrryrrrrr"/>

        <!-- 4: East/West straight + right -->
        <phase duration="20" state="rrrrGGrrrrrrGGrr"/>
        <!-- 5: yellow for EW straight + right -->
        <phase duration="3"  state="rrrryyrrrrrryyrr"/>

        <!-- 6: East/West protected left -->
        <phase duration="10" state="rrrrrrGrrrrrrrGr"/>
        <!-- 7: yellow for EW left -->
        <phase duration="3"  state="rrrrrryrrrrrrryr"/>
    </tlLogic>
</additional>
